# Add to the separately tested Render release; never copy DEV .env or .runtime.
APP_ENV=production
FAMILY_RELEASE_ENABLED=yes
FAMILY_PUBLIC_ORIGIN=https://ataberktasci.com.tr
FAMILY_DB_SCHEMA=ataberk_family_v1
# Dedicated restricted role on existing PostgreSQL; TLS verification is mandatory.
FAMILY_DATABASE_URL=
FAMILY_ADMIN_EMAIL=
FAMILY_SESSION_SECRET=
FAMILY_CAPSULE_KEY=
FAMILY_ADMIN_PASSWORD_HASH=
# Reuse existing Render Cloudinary / Resend secrets in place; do not paste into Git.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RESEND_API_KEY=
# A sender verified by the existing Resend account is required.
FAMILY_MAIL_FROM=
FAMILY_MAIL_TEST_RECIPIENT=
# Until staging validation, ONLY the selected test recipient may receive mail.
FAMILY_MAIL_ENABLED=no
