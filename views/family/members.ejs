<%- include('../partials/header') %><section class="section-wrap"><div class="page-heading"><span class="eyebrow">BU HİKÂYENİN KAHRAMANLARI</span><h1>Bizim aile<span class="heading-dot">.</span></h1><p>Her birimiz başka bir renk, birlikte kocaman bir dünya.</p></div><div class="members-grid"><% members.forEach((m,i)=>{ %><article class="member-card"><% if(m.avatar_key){ %><img class="avatar" src="/private/avatar/<%= m.id %>" alt="<%= m.name %> profil fotoğrafı" loading="lazy"><% }else{ %><span class="avatar tone-<%= i%3 %>"><%= m.name[0].toLocaleUpperCase('tr') %></span><% } %><h2><%= m.name %></h2><p><%= m.role==='family_admin'?'Aile yöneticisi':'Aile üyesi' %></p></article><% }) %></div></section><%- include('../partials/footer') %>
