<div class="album-grid"><% albums.forEach((a,i)=>{ %><a class="album-card tone-<%= i%3 %>" href="/album/<%= a.id %>"><div class="album-art <%= a.cover_id?'has-cover':'' %>"><% if(a.cover_id){ %><img src="/private/media/<%= a.cover_id %>" alt="<%= a.title %> albüm kapağı" loading="lazy"><span class="cover-badge">♧ Aileye özel</span><% }else{ %><span aria-hidden="true"><%= ['☀','✿','♡'][i%3] %></span><div class="album-lines"></div><% } %></div><div class="album-info"><span class="eyebrow"><%= a.media_count %> ANI · ÖZEL ALBÜM</span><h2><%= a.title %></h2><p><%= a.description %></p><span class="text-link">Albümü aç ↗</span></div></a><% }) %></div>
