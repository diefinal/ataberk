<%- include('../partials/header') %><section class="section-wrap"><div class="page-heading"><span class="eyebrow">BİZİ BİRBİRİMİZE BAĞLAYANLAR</span><h1>Aile <em>ağacımız.</em></h1><p>Yalnız görünmeyi seçen aile üyeleri burada yer alır. Doğum tarihi veya özel kişi bilgisi eklenmez.</p></div><section class="panel"><form class="action-row" method="post" action="/profil/agac"><input type="hidden" name="_csrf" value="<%= csrf %>"><label class="inline-check"><input type="checkbox" name="visible" value="yes" <%= user.tree_visible?'checked':'' %>>Aile ağacında görünmek istiyorum</label><button class="button small outline">Tercihimi kaydet</button></form></section><section class="panel tree-panel"><div class="tree-canvas" data-family-tree><svg class="tree-lines" aria-hidden="true"></svg><% people.forEach(p=>{ %><article class="tree-person" data-tree-id="<%= p.id %>"><% if(p.avatar_key){ %><img class="avatar" src="/private/avatar/<%= p.id %>" alt="<%= p.name %>"><% }else{ %><span class="avatar tone-0"><%= p.name[0] %></span><% } %><h3><%= p.name %></h3></article><% }) %></div><% if(!people.length){ %><div class="empty-state"><h2>İlk dal senden gelsin.</h2><p>Görünür olmayı seçtiğinde ağacımız büyümeye başlar.</p></div><% } %></section><div class="admin-grid"><section class="panel"><h2>Bir bağ ekle</h2><form action="/agac/bag" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>İlk üye<select name="parent_id"><% people.forEach(p=>{ %><option value="<%= p.id %>"><%= p.name %></option><% }) %></select></label><label>Bağ<select name="kind"><option value="parent">İlk üye, ikinci üyenin ebeveyni</option><option value="partner">Eş / hayat arkadaşı</option></select></label><label>İkinci üye<select name="child_id"><% people.forEach(p=>{ %><option value="<%= p.id %>"><%= p.name %></option><% }) %></select></label><p class="fine-print">Üyeler kendi bağlarını, yöneticiler ailedeki bağları düzenleyebilir.</p><button class="button small">Bağı ekle</button></form></section><section class="panel"><h2>Bağlarımız</h2><% links.forEach(l=>{ %><article class="tree-link" data-parent="<%= l.parent_id %>" data-child="<%= l.child_id %>" data-kind="<%= l.kind %>"><p><strong><%= l.parent_name %></strong> → <%= l.child_name %><br><small><%= l.kind==='parent'?'Ebeveyn bağı':'Hayat arkadaşı bağı' %></small></p><% if(l.created_by===user.id||user.role==='family_admin'||user.super_admin){ %><details><summary>Bağı kaldır</summary><form method="post" action="/agac/bag/<%= l.id %>/kaldir"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>KALDIR yaz<input name="confirm" required pattern="KALDIR"></label><button class="button small outline">Kaldır</button></form></details><% } %></article><% }) %></section></div></section><script src="/js/family-tree.js" defer></script><%- include('../partials/footer') %>
