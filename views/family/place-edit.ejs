<%- include('../partials/header') %><section class="narrow section-wrap"><section class="panel"><span class="eyebrow">BİR YER, BİR HATIRA</span><h1>Bu anı <em>neredendi?</em></h1><p><%= media.title %> · İsteğe bağlı bilgi. Tam adres veya hassas konum yazma.</p><form action="/medya/<%= media.id %>/konum" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Bölge<select name="region"><option value="">Haritada gösterme</option><% Object.entries(regions).forEach(([key,r])=>{ %><option value="<%= key %>" <%= place?.region===key?'selected':'' %>><%= r.name %></option><% }) %></select></label><label>Şehir <small>(İsteğe bağlı)</small><input name="city" maxlength="80" value="<%= place?.city||'' %>" placeholder="Şehir veya bölge adı"></label><button class="button small">Harita tercihimi kaydet</button></form></section></section><%- include('../partials/footer') %>
