<%- include('../partials/header') %><section class="section-wrap media-detail"><a class="text-link" href="/album/<%= media.album_id %>">← <%= media.album_title %></a><div class="detail-grid"><div class="media-stage"><% if(media.type==='image'){ %><img src="/private/media/<%= media.id %>" alt="<%= media.title %>"><% }else{ %><video controls preload="metadata" <% if(media.poster_id){ %>poster="/private/media/<%= media.poster_id %>"<% } %> src="/private/media/<%= media.id %>"></video><% } %></div><div class="detail-copy"><button class="button small outline detail-fullscreen" type="button" data-gallery-open data-src="/private/media/<%= media.id %>" data-title="<%= media.title %>" data-type="<%= media.type %>" data-id="<%= media.id %>">Tam ekranda aç ⤢</button><span class="eyebrow">AİLE ANISI / ÖZEL</span><h1><%= media.title %></h1><p><%= media.description %></p><a class="button outline" href="/aile-api/indir/<%= media.id %>">Dosyayı indir ↓</a><form class="favorite-form" method="post" action="/aile-api/favori/<%= media.id %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="favorite-button" type="submit" aria-pressed="<%= isFavorite %>"><%= isFavorite?'♥ Favorilerimde':'♡ Favorilerime ekle' %></button><a href="/favoriler">Favorilerime git →</a></form><div class="photo-story"><% if(media.taken_on){ %><p><strong>Tarih</strong> <%= new Date(media.taken_on).toLocaleDateString('tr-TR',{timeZone:'Europe/Istanbul'}) %></p><% } %><% if(media.place_text){ %><p><strong>Yer</strong> <%= media.place_text %></p><% } %><% if(people.length){ %><p><strong>Bu karede</strong> <%= people.map(p=>p.name).join(', ') %></p><% } %><% if(user.role==='family_admin'||user.super_admin){ %><a class="text-link" href="/aile-medya/<%= media.id %>/hikaye">Tarih, kişi ve kapak bilgilerini düzenle ↗</a><a class="text-link" href="/aile-medya/<%= media.id %>/konum">Bölgeyi seç ↗</a><% } %></div><h3>Bir küçük tepki bırak</h3><div class="reactions"><% ['❤️','😍','🔥','👏'].forEach(emoji=>{ %><form method="post" action="/aile-api/reaksiyon/<%= media.id %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="emoji" value="<%= emoji %>"><button type="submit" aria-label="<%= emoji %> tepkisi"><%= emoji %></button></form><% }) %></div><p class="reaction-summary" data-reactions="<%= media.id %>" aria-live="polite"></p></div></div><%- include('voices') %><div class="comments"><h2>Bu anıya bir not.</h2><% comments.forEach(c=>{ %><article><strong><%= c.author %></strong><p><%= c.content %></p><% if(user.role==='family_admin'||user.super_admin){ %><form method="post" action="/admin/yorumlar/sil/<%= c.id %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="text-button" type="submit">Yorumu kaldır</button></form><% } %></article><% }) %><form method="post" action="/aile-api/yorum/<%= media.id %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Yorumun<textarea name="content" required maxlength="500" rows="3" placeholder="Ne güzel bir gündü…"></textarea></label><button class="button small" type="submit">Notu ekle ↗</button></form></div></section><%- include('../partials/footer') %>
