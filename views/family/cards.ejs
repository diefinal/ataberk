<div class="media-grid family-media-grid"><% items.forEach(m=>{ %><article class="media-card family-media-card"><a href="/medya/<%= m.id %>"><div class="media-visual"><% if(m.type==='image'){ %><img src="/private/media/<%= m.id %>" alt="<%= m.title %>" loading="lazy"><% }else{ %><video src="/private/media/<%= m.id %>" preload="metadata" muted <% if(m.poster_id){ %>poster="/private/media/<%= m.poster_id %>"<% } %>></video><span class="play-badge" aria-label="Video">▶</span><% } %></div><div class="media-caption"><span class="eyebrow"><%= m.album_title %></span><h3><%= m.title %></h3><p><%= m.description %></p></div></a><button class="gallery-open" type="button" data-gallery-open data-src="/private/media/<%= m.id %>" data-title="<%= m.title %>" data-type="<%= m.type %>" data-id="<%= m.id %>" <% if(m.poster_id){ %>data-poster="/private/media/<%= m.poster_id %>"<% } %> aria-label="<%= m.title %> tam ekranda aç">⤢ Tam ekran</button></article><% }) %></div><% if(!items.length){ %><div class="empty-state"><span>✧</span><h2>Bu sayfa yeni anılar bekliyor.</h2><p>İçerik eklendiğinde burada görünecek.</p></div><% } %>
