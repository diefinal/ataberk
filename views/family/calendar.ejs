<%- include('../partials/header') %><section class="section-wrap"><div class="page-heading"><span class="eyebrow">BİRLİKTE GELECEK GÜNLER</span><h1>Aile <em>takvimimiz.</em></h1><p>Doğum günleri, buluşmalar ve kutlamalar. Her etkinlik bağlı olduğu albümün üyelerine özeldir.</p></div><form class="calendar-month" method="get"><label>Ay seç<input type="month" name="ay" value="<%= month %>"></label><button class="button small">Göster</button></form><div class="notes-layout"><section class="panel"><h2>Bir günü işaretle.</h2><% if(albums.length){ %><form action="/takvim" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Albüm<select name="album_id"><% albums.forEach(a=>{ %><option value="<%= a.id %>"><%= a.title %></option><% }) %></select></label><label>Etkinlik adı<input name="title" required maxlength="200"></label><label>Tarih<input type="date" name="event_on" required></label><label>Saat <small>(İsteğe bağlı)</small><input type="time" name="event_time"></label><label>Tür<select name="kind"><option value="meetup">Buluşma</option><option value="birthday">Doğum günü</option><option value="celebration">Kutlama</option></select></label><label class="inline-check"><input type="checkbox" name="annually" value="yes">Her yıl aynı gün göster</label><label>Küçük not<textarea name="description" maxlength="1000" rows="3"></textarea></label><button class="button small">Takvime ekle ↗</button></form><% }else{ %><p>Etkinlik eklemek için bir albüme erişim izni gerekli.</p><% } %></section><div class="notes-wall"><% events.forEach(e=>{ %><article class="note-card calendar-card"><span class="calendar-day"><%= e.display_date.slice(8) %></span><span class="eyebrow"><%= e.album_title %> / <%= {birthday:'DOĞUM GÜNÜ',meetup:'BULUŞMA',celebration:'KUTLAMA'}[e.kind] %></span><h2><%= e.title %></h2><p><%= e.description %></p><small><%= e.display_date %><%= e.event_time?' · '+e.event_time.slice(0,5):'' %><%= e.annually?' · Her yıl':'' %></small><% if(e.user_id===user.id||user.role==='family_admin'||user.super_admin){ %><details><summary>Etkinliği kaldır</summary><form method="post" action="/takvim/<%= e.id %>/kaldir"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Onay için KALDIR yaz<input name="confirm" required pattern="KALDIR"></label><button class="button small outline">Kaldır</button></form></details><% } %></article><% }) %><% if(!events.length){ %><div class="empty-state"><span>◷</span><h3>Bu ayın sayfası açık.</h3><p>Yeni bir buluşmaya ya da kutlamaya yer var.</p></div><% } %></div></div></section><%- include('../partials/footer') %>
