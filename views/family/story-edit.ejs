<%- include('../partials/header') %><section class="narrow section-wrap"><div class="panel"><span class="eyebrow">FOTOĞRAFIN ARDINDAKİ HİKÂYE</span><h1><%= media.title %></h1><form method="post" action="/medya/<%= media.id %>/hikaye"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Bu an ne zamandı?<input name="taken_on" type="date" value="<%= media.taken_on?new Date(media.taken_on).toLocaleDateString('sv-SE',{timeZone:'Europe/Istanbul'}):'' %>"></label><label>Neredeydik? <small>(İsteğe bağlı)</small><input name="place_text" maxlength="160" value="<%= media.place_text %>" placeholder="Örneğin: Evdeki ilk doğum günü"></label><fieldset class="people-picker"><legend>Bu karede kimler var?</legend><% people.forEach(p=>{ %><label><input type="checkbox" name="people" value="<%= p.id %>" <%= tagged.includes(p.id)?'checked':'' %>><span><%= p.name %></span></label><% }) %></fieldset><% if(media.type==='video'){ %><label>Video kapağı<select name="poster_media_id"><option value="">Videonun kendi ilk karesi</option><% posters.forEach(p=>{ %><option value="<%= p.id %>" <%= media.poster_media_id===p.id?'selected':'' %>><%= p.title %></option><% }) %></select></label><% } %><button class="button">Hikâyeyi kaydet ↗</button></form></div></section><%- include('../partials/footer') %>
