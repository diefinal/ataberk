<%- include('../partials/header') %><section class="auth-layout"><div class="auth-intro"><span class="eyebrow"><%= adminLogin?'AİLEMİZİN YÖNETİM ALANI':'AİLEMİZİN KAPISI' %></span><h1><%= adminLogin?'Anıları birlikte':'Güzel anılar' %><br><em><%= adminLogin?'düzenleyelim.':'içeride.' %></em></h1><p><%= adminLogin?'Yetkili hesabınla giriş yap; albümleri, ilkleri ve aile davetlerini yönet.':'Yalnız davetli aile üyeleri giriş yapabilir. Birlikte biriktirdiklerimiz bize özel kalsın.' %></p><div class="auth-ornament" aria-hidden="true">♡ <span>✦</span></div></div><div class="form-card"><nav class="login-switch" aria-label="Giriş türü"><a href="/giris" <%- !adminLogin?'aria-current="page"':'' %>>Aile girişi</a><a href="/admin/giris" <%- adminLogin?'aria-current="page"':'' %>>Yönetici girişi</a></nav><span class="pill"><%= adminLogin?'YÖNETİCİ HESABI':'GÜVENLİ AİLE ALANI' %></span><h2><%= step==='email'?'Hoş geldin.':'Posta kutuna bir bak.' %></h2><p><%= step==='email'?'Davet edildiğin e-posta adresinle devam et.':'10 dakika geçerli, altı haneli kodunu yaz.' %></p><% if(message){ %><div class="notice" role="status"><%= message %></div><% } %><form method="post" action="<%= step==='email'?'/giris':'/dogrula' %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><% if(step==='email'){ %><label>E-posta adresin<input type="email" name="email" required autocomplete="email" maxlength="254" placeholder="adiniz@ornek.test"></label><% }else{ %><label>Doğrulama kodu<input class="otp-input" name="code" required pattern="[0-9]{6}" maxlength="6" inputmode="numeric" autocomplete="one-time-code" placeholder="000000"></label><% } %><button class="button full" type="submit"><%= step==='email'?'Giriş kodu iste':adminLogin?'Yönetim paneline git':'Aile alanına gir' %> ↗</button></form><% if(step==='code'){ %><a class="text-link" href="<%= adminLogin?'/admin/giris':'/giris' %>">Farklı bir e-posta kullan</a><% } %><% if(adminLogin){ %><p class="fine-print">Yönetim paneli yalnız yetkili aile yöneticilerine açıktır.</p><% } %><% if(!production){ %><details class="dev-login-help"><summary>DEV test hesabıyla nasıl girerim?</summary><p>Test adresi: <code><%= adminLogin?'yonetici@example.test':'uye@example.test' %></code></p><p>Önce kod iste. Sonra DEV klasöründeki PowerShell’de:</p><code class="command-line">node scripts/outbox.js <%= adminLogin?'yonetici@example.test':'uye@example.test' %></code><p>Çıkan <code>code</code> değerini yaz. Gerçek e-posta gönderilmez.</p></details><% } %></div></section><%- include('../partials/footer') %>
