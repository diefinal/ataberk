<%- include('../partials/header') %><section class="section-wrap admin-page"><div class="page-heading"><span class="eyebrow">SEVGİYLE DÜZENLEYELİM</span><h1>Aile yönetimi<span class="heading-dot">.</span></h1><p>Albümler, anılar ve ailemiz. Tüm yönetim işlemleri kaydedilir.</p></div><nav class="admin-tabs"><a href="/admin/sifre">Şifrem</a><a href="/admin/katkilar">Bekleyen fotoğraflar</a><a href="/admin/vitrin">Ana sayfa vitrini</a><a href="#albums">Albümler</a><a href="#album-covers">Kapaklar</a><a href="#upload">Medya yükle</a><a href="#memories">Anılar</a><a href="#members">Üyeler ve izinler</a><a href="#audit">İşlem kayıtları</a></nav>
<div class="admin-grid"><section class="panel" id="albums"><span class="eyebrow">01 / ALBÜMLER</span><h2>Yeni bir sayfa aç.</h2><form method="post" action="/admin/albumler"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Albüm adı<input name="title" required maxlength="200" placeholder="Bir yaz masalı"></label><label>Açıklama<textarea name="description" maxlength="2000" rows="2"></textarea></label><button class="button small">Albüm oluştur ↗</button></form><% albums.forEach(a=>{ %><details><summary><%= a.title %> · <%= a.media_count %> medya</summary><form method="post" action="/admin/albumler/<%= a.id %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Adı<input name="title" value="<%= a.title %>" required maxlength="200"></label><label>Açıklama<textarea name="description" maxlength="2000"><%= a.description %></textarea></label><button class="button small outline">Kaydet</button></form></details><% }) %></section>
<section class="panel" id="upload"><span class="eyebrow">02 / FOTOĞRAF & VİDEO</span><h2>Yeni anılar ekle.</h2><form method="post" action="/admin/yukle" enctype="multipart/form-data" data-upload><label>Albüm<select name="album_id" required><option value="">Albüm seç</option><% albums.forEach(a=>{ %><option value="<%= a.id %>"><%= a.title %></option><% }) %></select></label><label>Başlık<input name="title" maxlength="200" required></label><label>Açıklama<textarea name="description" maxlength="2000" rows="2"></textarea></label><label class="upload-zone">Dosyalarını seç <span>JPEG, PNG veya MP4 · en fazla 10 dosya<br>Dosya başına 30 MB, toplam 60 MB</span><input name="file" type="file" accept="image/jpeg,image/png,video/mp4" multiple required></label><button class="button small">Anıları yükle ↑</button><p data-upload-status aria-live="polite"></p></form></section>
<section class="panel" id="memories"><span class="eyebrow">03 / ZAMAN ÇİZELGESİ</span><h2>Bir anı yaz.</h2><form method="post" action="/admin/anilar"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Albüm<select name="album_id" required><% albums.forEach(a=>{ %><option value="<%= a.id %>"><%= a.title %></option><% }) %></select></label><label>Anı başlığı<input name="title" required maxlength="200"></label><label>Anı türü<select name="kind"><option value="story">Bir aile anısı</option><option value="first">✦ Ataberk’in ilkleri</option></select></label><label>Ne zamandı?<input name="occurred_on" type="date" required></label><label>Hikâyesi<textarea name="description" maxlength="4000" rows="3"></textarea></label><label>İlgili medya <small>(İsteğe bağlı; seçilen albümden olmalı)</small><select name="media_ids" multiple size="3"><% items.forEach(m=>{ %><option value="<%= m.id %>"><%= m.album_title %> / <%= m.title %></option><% }) %></select></label><button class="button small">Anıyı kaydet ↗</button></form></section>
<section class="panel" id="members"><span class="eyebrow">04 / AİLEMİZ</span><h2>Birini davet et.</h2><form method="post" action="/admin/davet"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>E-posta<input type="email" name="email" required maxlength="254"></label><label>Rol<select name="role"><option value="member">Aile üyesi</option><option value="family_admin">Aile yöneticisi</option></select></label><button class="button small">Test daveti oluştur ↗</button><p class="fine-print">48 saat geçerli. Gerçek e-posta gönderilmez; yerel test kutusuna yazılır.</p></form><h3>Albüm erişimi</h3><form method="post" action="/admin/izin"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Üye<select name="user_id"><% members.forEach(m=>{ %><option value="<%= m.id %>"><%= m.name %></option><% }) %></select></label><label>Albüm<select name="album_id"><% albums.forEach(a=>{ %><option value="<%= a.id %>"><%= a.title %></option><% }) %></select></label><label>Erişim<select name="allowed"><option value="yes">İzin ver</option><option value="no">İzni kaldır</option></select></label><button class="button small outline">İzni güncelle</button></form><details><summary>Mevcut albüm izinleri (<%= permissions.length %>)</summary><% permissions.forEach(p=>{ %><p><%= members.find(m=>m.id===p.user_id)?.name %> → <%= albums.find(a=>a.id===p.album_id)?.title %></p><% }) %></details></section></div>
<%- include('cover-admin') %><section class="panel"><h2>Üyeler ve roller</h2><div class="table-scroll"><table><thead><tr><th>Üye</th><th>Rol ve durum</th><th>İşlem</th></tr></thead><tbody><% members.forEach(m=>{ %><tr><td><strong><%= m.name %></strong><br><small><%= m.email %></small></td><td><% if(m.id===user.id||m.super_admin){ %><%= m.super_admin?'Süper yönetici':m.role==='family_admin'?'Aile yöneticisi':'Aile üyesi' %><% }else{ %><form id="member-<%= m.id %>" method="post" action="/admin/uyeler/<%= m.id %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><select aria-label="<%= m.name %> rolü" name="role"><option value="member" <%= m.role==='member'?'selected':'' %>>Aile üyesi</option><option value="family_admin" <%= m.role==='family_admin'?'selected':'' %>>Aile yöneticisi</option></select><select aria-label="<%= m.name %> durumu" name="active"><option value="yes" <%= m.active?'selected':'' %>>Aktif</option><option value="no" <%= !m.active?'selected':'' %>>Pasif</option></select></form><% } %></td><td><% if(m.id!==user.id&&!m.super_admin){ %><button form="member-<%= m.id %>" class="button small outline">Kaydet</button><% }else{ %><span>Korunan hesap</span><% } %></td></tr><% }) %></tbody></table></div></section>
<section class="panel"><h2>İçerikleri düzenle</h2><% items.forEach(m=>{ %><details><summary><%= m.title %> <small>· <%= m.album_title %></small></summary><form method="post" action="/admin/duzenle/<%= m.id %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Başlık<input name="title" required value="<%= m.title %>" maxlength="200"></label><label>Açıklama<textarea name="description" maxlength="2000"><%= m.description %></textarea></label><div class="action-row"><button class="button small outline">Kaydet</button><a class="text-link" href="/aile-medya/<%= m.id %>">Görüntüle</a><a class="text-link danger-text" href="/admin/sil/<%= m.id %>">Kaldır…</a></div></form></details><% }) %></section>
<section class="panel"><h2>Anıları düzenle</h2><% memories.forEach(m=>{ %><details><summary><%= m.title %></summary><form method="post" action="/admin/anilar/<%= m.id %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Başlık<input name="title" value="<%= m.title %>" required maxlength="200"></label><label>Anı türü<select name="kind"><option value="story" <%= m.kind==='story'?'selected':'' %>>Bir aile anısı</option><option value="first" <%= m.kind==='first'?'selected':'' %>>Ataberk’in ilkleri</option></select></label><label>Tarih<input type="date" name="occurred_on" value="<%= new Date(m.occurred_on).toLocaleDateString('sv-SE',{timeZone:'Europe/Istanbul'}) %>" required></label><label>Açıklama<textarea name="description" maxlength="4000"><%= m.description %></textarea></label><button class="button small outline">Değişiklikleri kaydet</button></form><form method="post" action="/admin/ani-kaldir/<%= m.id %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Kaldırmak için SİL yaz<input name="confirm" required pattern="SİL" autocomplete="off"></label><button class="button small danger">Anıyı kaldır</button></form></details><% }) %></section>
<%- include('archived-memories') %><section class="panel" id="audit"><span class="eyebrow">İZLENEBİLİR YÖNETİM</span><h2>Son işlem kayıtları</h2><div class="table-scroll"><table><thead><tr><th>Zaman</th><th>Kim</th><th>İşlem</th><th>Hedef</th><th>Geri al</th></tr></thead><tbody><% logs.forEach(l=>{ %><tr><td><%= new Date(l.created_at).toLocaleString('tr-TR',{timeZone:'Europe/Istanbul'}) %></td><td><%= l.actor %></td><td><%= l.action %></td><td><%= l.target %></td><td><% if(l.action==='media.soft_delete'){ %><form method="post" action="/admin/geri-al/<%= l.target %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="button small outline">Geri al</button></form><% } %></td></tr><% }) %></tbody></table></div></section></section><%- include('../partials/footer') %>
